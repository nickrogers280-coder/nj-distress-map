# Copy to .env for local runs (GitHub uses repository secrets instead).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Comma-separated list of recipients
ALERT_TO=you@gmail.com
ALERT_FROM=
CONTACT_EMAIL=you@gmail.com
